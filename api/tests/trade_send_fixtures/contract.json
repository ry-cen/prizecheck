{
  "operation": {
    "description": "Open a Trade thread with a first offer and optional message.\n\nShape and replay precede all reads. Message and contact advisory locks precede\nboth owner locks; reach, the stranger quota, cash eligibility and listable caps\nare checked before insertion. Only the proposer's cards are promised.",
    "operationId": "send_trade_proposal_api_trades_post",
    "parameters": [
      {
        "in": "header",
        "name": "x-internal-user",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "X-Internal-User"
        }
      },
      {
        "in": "header",
        "name": "x-internal-time",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "X-Internal-Time"
        }
      },
      {
        "in": "header",
        "name": "x-internal-signature",
        "required": false,
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "X-Internal-Signature"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/SendTradeProposal"
          }
        }
      },
      "required": true
    },
    "responses": {
      "201": {
        "content": {
          "application/json": {
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TradeView"
                },
                {
                  "$ref": "#/components/schemas/ReplayedTradeSend"
                }
              ],
              "title": "Response Send Trade Proposal Api Trades Post"
            }
          }
        },
        "description": "Successful Response"
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPValidationError"
            }
          }
        },
        "description": "Validation Error"
      }
    },
    "summary": "Send Trade Proposal",
    "tags": ["trades"]
  },
  "schemas": {
    "HTTPValidationError": {
      "properties": {
        "detail": {
          "items": {
            "$ref": "#/components/schemas/ValidationError"
          },
          "title": "Detail",
          "type": "array"
        }
      },
      "title": "HTTPValidationError",
      "type": "object"
    },
    "ReplayedTradeSend": {
      "description": "A historical send was applied; these are explicitly the current accessible terms.",
      "properties": {
        "label": {
          "const": "Current Trade",
          "title": "Label",
          "type": "string"
        },
        "outcome": {
          "const": "already_applied",
          "title": "Outcome",
          "type": "string"
        },
        "trade": {
          "$ref": "#/components/schemas/TradeView"
        },
        "view": {
          "const": "current",
          "title": "View",
          "type": "string"
        }
      },
      "required": ["outcome", "view", "label", "trade"],
      "title": "ReplayedTradeSend",
      "type": "object"
    },
    "SendTradeProposal": {
      "description": "A Trade Proposal. Exactly one of ``recipient_id`` (a Friend's user id, as before) and ``recipient_trader_id``\n(any collector in reach) names the recipient; neither or both is 422 RECIPIENT_REQUIRED.",
      "properties": {
        "cash": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/TradeCashRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Message"
        },
        "recipient_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient Id"
        },
        "recipient_trader_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recipient Trader Id"
        },
        "you_get": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/TradeLineRequest"
          },
          "title": "You Get",
          "type": "array"
        },
        "you_give": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/TradeLineRequest"
          },
          "title": "You Give",
          "type": "array"
        }
      },
      "required": ["idempotency_key"],
      "title": "SendTradeProposal",
      "type": "object"
    },
    "TradeCard": {
      "description": "One Card Edition one side gives, with how many copies.",
      "properties": {
        "collector_number": {
          "title": "Collector Number",
          "type": "string"
        },
        "copies": {
          "title": "Copies",
          "type": "string"
        },
        "descriptor": {
          "additionalProperties": true,
          "title": "Descriptor",
          "type": "object"
        },
        "edition_id": {
          "format": "uuid",
          "title": "Edition Id",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Url"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "set_code": {
          "title": "Set Code",
          "type": "string"
        },
        "set_name": {
          "title": "Set Name",
          "type": "string"
        }
      },
      "required": [
        "edition_id",
        "name",
        "set_code",
        "set_name",
        "collector_number",
        "descriptor",
        "image_url",
        "copies"
      ],
      "title": "TradeCard",
      "type": "object"
    },
    "TradeCash": {
      "description": "Cash recorded with the Trade, in US cents, and who pays it. The app never handles money (Trading #277).",
      "properties": {
        "cents": {
          "title": "Cents",
          "type": "string"
        },
        "payer": {
          "enum": ["you", "them"],
          "title": "Payer",
          "type": "string"
        }
      },
      "required": ["cents", "payer"],
      "title": "TradeCash",
      "type": "object"
    },
    "TradeCashRequest": {
      "properties": {
        "cents": {
          "title": "Cents",
          "type": "string"
        },
        "payer": {
          "enum": ["you", "them"],
          "title": "Payer",
          "type": "string"
        }
      },
      "required": ["cents", "payer"],
      "title": "TradeCashRequest",
      "type": "object"
    },
    "TradeLineRequest": {
      "properties": {
        "edition_id": {
          "format": "uuid",
          "title": "Edition Id",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": ["edition_id", "quantity"],
      "title": "TradeLineRequest",
      "type": "object"
    },
    "TradeParty": {
      "description": "The other side of the Trade, as the reader may see them (Trading #299, spec \"Identity\").\n\n``friend``: the other has a profile and is the reader's Friend now (an accepted friendship, no Block). Only then are\n``collector_id`` and ``handle`` set; for anyone else they are None, so ``collector_id is None`` no longer means the\naccount is deleted. ``trader_id``: the other's address on the trader routes and in the builder, None once that\naccount is deleted; never shown. ``available``: the other is in the reader's reach now (a Friend, a shared\nconversation or nearby in open discovery, with no Block and no suspension on either side). The name is kept. Not\navailable reads the same for a Block, a suspension and a deletion, apart from ``trader_id`` and the name.\n``open_to_cash_offers``: their own setting (``/api/social/trade-settings``, Trading #277), False when not available.\n``completed_trades``: how many Trades they have completed (``completed_trades``), None when not available.\n``trader_id``, ``friend``, ``available`` and ``completed_trades`` have defaults so a stored replay from before they\nexisted still validates.",
      "properties": {
        "available": {
          "default": false,
          "title": "Available",
          "type": "boolean"
        },
        "collector_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Collector Id"
        },
        "completed_trades": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed Trades"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "friend": {
          "default": false,
          "title": "Friend",
          "type": "boolean"
        },
        "handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Handle"
        },
        "open_to_cash_offers": {
          "title": "Open To Cash Offers",
          "type": "boolean"
        },
        "trader_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trader Id"
        }
      },
      "required": [
        "collector_id",
        "handle",
        "display_name",
        "open_to_cash_offers"
      ],
      "title": "TradeParty",
      "type": "object"
    },
    "TradeView": {
      "description": "One Trade Proposal or Trade as the reader sees it. ``you_give`` and ``you_get`` are the reader's side and the\nother side, in the order they were listed. Never a pick, a destination, a Location or a Deck. ``conversation_id``:\nthe pair's conversation (Trading #298), None for a Trade of a pair that has none; it defaults to None so a stored\nreplay from before it existed still validates.",
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "accept",
              "decline",
              "counter",
              "confirm_swap",
              "use_suggested_picks",
              "withdraw",
              "cancel",
              "change_offer"
            ],
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "cash": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/TradeCash"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_by": {
          "anyOf": [
            {
              "enum": ["you", "them"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed By"
        },
        "closed_reason": {
          "anyOf": [
            {
              "enum": [
                "declined",
                "withdrawn",
                "countered",
                "cancelled",
                "swapped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed Reason"
        },
        "conversation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conversation Id"
        },
        "countered_from": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Countered From"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "needs_you": {
          "title": "Needs You",
          "type": "boolean"
        },
        "offer_id": {
          "format": "uuid",
          "title": "Offer Id",
          "type": "string"
        },
        "other": {
          "$ref": "#/components/schemas/TradeParty"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "role": {
          "enum": ["proposer", "recipient"],
          "title": "Role",
          "type": "string"
        },
        "section": {
          "enum": ["needs_you", "to_swap", "pending", "history"],
          "title": "Section",
          "type": "string"
        },
        "state": {
          "enum": ["proposed", "accepted", "closed"],
          "title": "State",
          "type": "string"
        },
        "they_confirmed_swap": {
          "title": "They Confirmed Swap",
          "type": "boolean"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        },
        "waiting": {
          "anyOf": [
            {
              "enum": ["answer", "fix_picks", "confirm_swap"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Waiting"
        },
        "you_confirmed_swap": {
          "title": "You Confirmed Swap",
          "type": "boolean"
        },
        "you_get": {
          "items": {
            "$ref": "#/components/schemas/TradeCard"
          },
          "title": "You Get",
          "type": "array"
        },
        "you_give": {
          "items": {
            "$ref": "#/components/schemas/TradeCard"
          },
          "title": "You Give",
          "type": "array"
        }
      },
      "required": [
        "id",
        "thread_id",
        "offer_id",
        "state",
        "closed_reason",
        "closed_by",
        "role",
        "other",
        "countered_from",
        "you_give",
        "you_get",
        "cash",
        "you_confirmed_swap",
        "they_confirmed_swap",
        "needs_you",
        "waiting",
        "section",
        "actions",
        "revision",
        "created_at"
      ],
      "title": "TradeView",
      "type": "object"
    },
    "ValidationError": {
      "properties": {
        "ctx": {
          "title": "Context",
          "type": "object"
        },
        "input": {
          "title": "Input"
        },
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Location",
          "type": "array"
        },
        "msg": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "title": "Error Type",
          "type": "string"
        }
      },
      "required": ["loc", "msg", "type"],
      "title": "ValidationError",
      "type": "object"
    }
  }
}
