# Objects core/000_baseline.sql leaves in a database, which the runner checks before it records the baseline
# without running it (scripts/migration_tracks.py). Presence only: extra objects never block. One line per fact, sorted.
# GENERATED by migration_tracks.render_manifest from the baseline installed on an empty database; never edit by hand.
# api/tests/test_core_baseline.py fails if this differs from what the baseline builds.
table art_fetch_failure failures last_failed_at printing_id reason size source_url
table art_hit hits last_hit_at printing_id size
table art_large_upgrade base_url candidate_url checked_at failures height outcome printing_id reason width
table art_object byte_size content_type printing_id sha256 size source_url storage_key stored_at
table block blocked_id blocker_id handle_shown id via
table borrowed_holding borrower_id edition_id id loan_id location_id quantity
table collection_import catalog_revision changed_at created_at draft_revision excluded_groups expires_at id location_id owner_id save_key save_result saved_at source source_header status
table collection_import_row candidates edition_id fix group_name import_id left_out_reason parsed printing_id quantity raw_text row_number skipped status
table collection_import_start id owner_id started_at
table collector_profile display_name handle handle_changed_at handle_key open_to_cash_offers suspended_at trader_id user_id
table conversation changed_at created_at high_name id last_activity_at last_from_high_at last_from_low_at low_name user_high user_low
