table location created_at for_trade hidden id kind name owner_id parent_id version
table location_command created_at owner_id request_digest request_key response
table message body client_key conversation_id created_at from_low id
table missing_card_report approved_edition_id approved_printing_id collector_number created_at descriptor english_name evidence_url id kind note printing_id reporter_id review_reason reviewed_at reviewer_id set_id set_name status updated_at
table moderation_event action created_at id note owner_id report_id subject_id subject_name
table move_manifest expires_at id owner_id source_id
table move_manifest_entry edition_id expected_version owner_id quantity source_id
table move_manifest_item edition_id expected_version owner_id quantity
table move_response already_at_destination_count copy_count edition_count owner_id request_key source_count
table mutation_request command_digest expires_at owner_id request_key result_revision
table mutation_response owner_id request_key result_quantity result_version
table operations_alert created_at delivered_at id kind resolved_at
table operations_counter count name updated_at
table operations_hour authorization_denials elapsed_ms failures hour requests
table operations_quota allowance measured_at resource used
table operations_state backup_alerts backup_failures backup_last_success backup_stale projection_failures restore_failures restore_last_success singleton watchdog_last_check
