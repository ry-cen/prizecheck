table thread_member member_id read_at thread_id
table thread_message body client_key created_at from_low id thread_id
table thread_round_source kind round_id thread_id
table trade accepted_at cash_cents cash_payer closed_at closed_by closed_reason conversation_id countered_from created_at id proposer_id proposer_name proposer_swap_at recipient_id recipient_name recipient_swap_at revision state thread_id thread_kind
