DATABASE_URL=postgresql://tcg:tcg@127.0.0.1:5432/tcg
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
OWNER_EMAIL=owner@example.test
PUBLIC_ORIGIN=http://localhost:5173
AUTH_PORT=3001
AUTH_HOST=127.0.0.1
API_PORT=8000
DAILY_SEND_CAP=100
TRUSTED_PROXY_IPS=
MAIL_MODE=console

# Owner-only by default. See docs/signup-readiness.md before public activation.
SIGNUP_MODE=owner-only
# MAIL_MODE=http uses a provider adapter implementing this relay contract.
# MAIL_RELAY_URL=https://your-private-mail-relay.example/send
# MAIL_RELAY_TOKEN=inject-private-token
# MAIL_FROM=verified-sender@your-domain.example

# Public projection adapter: filesystem locally, HTTP relay remotely.
PUBLIC_PROJECTION_ADAPTER=filesystem
PUBLIC_PROJECTION_DIR=.local/public-projections
# PUBLIC_PROJECTION_URL=https://your-private-projection-relay.example/manifest
# PUBLIC_PROJECTION_TOKEN=inject-private-token

# Private backup storage must stay outside all served/public directories.
# BACKUP_PRIVATE_DIR=/absolute/private/backup-store
# BACKUP_STORE_FACTORY=your_provider.backups:create_store
# RESTORE_ADMIN_DATABASE_URL=inject-private-disposable-restore-admin-connection

# Release runtime control adapter. See docs/operations/release.md.
# RELEASE_CONTROL_KEY=inject-private-header-safe-key
# RELEASE_COMMIT=full-deployed-commit
# SIGNUP_READINESS_FILE=/absolute/private/audited-readiness.json
