# Build context for deploy/docker/*.Dockerfile. Keep secrets and local state out of every image.
**/.env
**/.env.*
!.env.example
**/*.env
deploy/unraid/

.git/
.github/
.claude/
.husky/
.scratch/
.local/
.venv/
**/node_modules/
dist/
test-results/
playwright-report/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
**/*.log
*.dump

# Test-only OAuth fake (auth/testing/): never in an image.
auth/testing/

# The scanner models are fetched inside the web image build (scripts/fetch-scanner-models.mjs), never copied in.
web/public/scanner/m/
