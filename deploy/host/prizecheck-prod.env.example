# PrizeCheck production on the Oracle host. Copy to $PRIZECHECK_HOME/prizecheck.env, fill in, then `chmod 600`.
# Placeholders only: never commit the filled-in file. See docs/deployment-oracle.md.
# Check it with `prizecheck-deploy.sh check-config` before the first deploy.

# Selects compose.prod.yml and the production checks in prizecheck-deploy.sh. The overlay forces NODE_ENV=production.
PRIZECHECK_ENVIRONMENT=prod
# Compose project name; never prizecheck-dev.
PRIZECHECK_PROJECT=prizecheck-prod
# Persistent data on the instance's boot volume. Holds postgres/, public/, price-runners/, mail/.
PRIZECHECK_DATA_DIR=/opt/prizecheck-prod/data
# Browser-facing port. Loopback only: Caddy on this host is the only public entry (deploy/oracle/Caddyfile).
PRIZECHECK_WEB_BIND=127.0.0.1
PRIZECHECK_WEB_PORT=8088
PRIZECHECK_REGISTRY=ghcr.io/ry-cen

# The exact browser origin on your domain: https, no path. OAuth callbacks are PUBLIC_ORIGIN/api/auth/callback/<id>.
PUBLIC_ORIGIN=https://prizecheck.example.com
OWNER_EMAIL=you@example.com
# Optional: the contact the daily price import sends to TCGCSV. Defaults to OWNER_EMAIL.
#PRICE_IMPORT_CONTACT=you@example.com

# Each: `openssl rand -hex 32`. Distinct values, never reused by another environment.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
INTERNAL_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Production sends sign-in codes through a mail relay (docs/signup-readiness.md); the gateway refuses file and console
# mail. Only EMAIL_SIGN_IN=on needs the relay; with an OAuth provider and email sign-in off, leave these commented out.
# To use it, fill in all three relay values (the URL must be https).
MAIL_MODE=http
# MAIL_RELAY_URL=https://your-private-mail-relay.example/send
# MAIL_RELAY_TOKEN=inject-private-token
# MAIL_FROM=verified-sender@your-domain.example
DAILY_SEND_CAP=100
# New OAuth accounts per rolling day, app-wide. The owner panel warns at 80%.
DAILY_SIGNUP_CAP=100

# Who may create an account: `owner-only` (default) or `public`. `public` takes effect for a release only while the
# readiness proof in $PRIZECHECK_HOME/signup/readiness.json is valid for that release's commit; otherwise the release runs
# owner-only. Steps: docs/deployment-oracle.md, "Opening signup". Leave this as owner-only until then.
SIGNUP_MODE=owner-only

# Email-code sign-in: `on` requires the mail relay above. With it off, set a Google or Discord client below; with no
# provider and EMAIL_SIGN_IN=off the auth gateway refuses to start.
EMAIL_SIGN_IN=off
# Provider credentials are deployment secrets. Set both values of a pair or neither. The redirect (callback) URL to
# register is https://<your domain>/api/auth/callback/<google|discord>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Production activates a marketplace matching rule only after an owner approval. Uncomment to activate automatically,
# as dev does.
# MARKETPLACE_MATCHING=automatic
