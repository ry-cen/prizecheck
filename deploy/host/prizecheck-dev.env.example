# PrizeCheck dev deployment on Unraid. Copy to $PRIZECHECK_HOME/prizecheck.env, fill in, then `chmod 600`.
# Placeholders only: never commit the filled-in file. See docs/deployment-unraid.md, step 6.
# Installed from deploy/host/ together with prizecheck-deploy.sh; the production template is prizecheck-prod.env.example.

# Which stack this host runs. `dev` is the default when the key is absent; production sets `prod` in its own file.
PRIZECHECK_ENVIRONMENT=dev
# Compose project name; production uses its own (prizecheck-prod).
PRIZECHECK_PROJECT=prizecheck-dev
# Persistent data on a pool path (not /mnt/user FUSE). Holds postgres/, public/, price-runners/, mail/, art/.
PRIZECHECK_DATA_DIR=/mnt/cache/appdata/prizecheck-dev/data
# Browser-facing port. Loopback only; Tailscale Serve on the host proxies HTTPS to it.
PRIZECHECK_WEB_BIND=127.0.0.1
PRIZECHECK_WEB_PORT=8088
PRIZECHECK_REGISTRY=ghcr.io/ry-cen

# The exact browser origin Tailscale Serve provides, including a non-443 port if you use one.
PUBLIC_ORIGIN=https://unraid.your-tailnet.ts.net
OWNER_EMAIL=you@example.com
# Optional: the contact the daily price import sends to TCGCSV. Defaults to OWNER_EMAIL.
#PRICE_IMPORT_CONTACT=you@example.com

# Each: `openssl rand -hex 32`. Distinct values, never reused by another environment.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
INTERNAL_AUTH_SECRET=replace-with-openssl-rand-hex-32

# Sign-in codes: `file` writes them to $PRIZECHECK_DATA_DIR/mail/codes.jsonl (read with `prizecheck-deploy.sh
# sign-in-code`). `http` uses a mail relay (docs/signup-readiness.md); set the three MAIL_* values below.
MAIL_MODE=file
# MAIL_RELAY_URL=https://your-private-mail-relay.example/send
# MAIL_RELAY_TOKEN=inject-private-token
# MAIL_FROM=verified-sender@your-domain.example
DAILY_SEND_CAP=100
# New OAuth accounts per rolling day, app-wide. The owner panel warns at 80%.
DAILY_SIGNUP_CAP=100

# Kill switch for collector prices. `on` (or unset) reads the imported prices; `off` answers "Price unavailable" everywhere
# without a price query. Set `off` and run `prizecheck-deploy.sh compose up -d api` to hide wrong prices, then back to `on`.
PRICE_READS=on

# Sign-in. Email codes stay on until a Google or Discord sign-in is registered and the owner has linked it; with no
# provider and EMAIL_SIGN_IN=off the auth gateway refuses to start. Provider credentials are deployment secrets.
EMAIL_SIGN_IN=on
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
