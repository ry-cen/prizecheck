[Unit]
Description=PrizeCheck daily price import, catalog change check and scanner index (ADR 0018, ADR 0019)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
# Runs as root with a bash invocation, as the nightly backup cron does (/etc/cron.d/prizecheck-backup).
User=root
Environment=HOME=/root
ExecStart=/bin/bash /opt/prizecheck-prod/bin/prizecheck-deploy.sh catalog-refresh
# Output goes to the journal: journalctl -u prizecheck-catalog-refresh
StandardOutput=journal
StandardError=journal
# The price import, a full pull and the scanner index can take more than an hour on 1 OCPU, so the run has no time limit.
TimeoutStartSec=infinity
# No Restart: the timer starts the next run, and the script's own non-blocking lock makes overlapping runs harmless.
# Stopping the unit ends the script and its docker client, not the one-off containers compose started; they keep running
# until they finish. They carry the label prizecheck.job=catalog-refresh, and the next deploy stops them
# (docs/deployment-oracle.md, step 16).
KillMode=control-group
